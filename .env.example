# MOR Identity API Configuration
# Set to 'true' to use real MOR Identity API, 'false' for local mock data
VITE_USE_MOR_IDENTITY=true

# MOR Identity API Base URL - Points to MOR Org Forge deployment
VITE_MOR_IDENTITY_URL=https://mor-org-forge.lovable.app/api/public/v1

# Local development API URL (uncomment for local testing)
# VITE_MOR_IDENTITY_URL=https://localhost:8080/api/public/v1

# Token refresh interval (milliseconds) - default 30 minutes
VITE_TOKEN_REFRESH_INTERVAL=1800000

# Development Mode
MODE=development
